<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gcs_map_app</name>
  <version>0.1.0</version>
  <description>Qt 6 GCS map POC: subscribes to /gcs/telemetry and shows the robot on offline map tiles stored in SQLite.</description>
  <maintainer email="you@example.com">GCS team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>gcs_interfaces</depend>
  <!-- Qt 6 is installed with apt (see HOW_TO_RUN.md); it is not a ROS package. -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
