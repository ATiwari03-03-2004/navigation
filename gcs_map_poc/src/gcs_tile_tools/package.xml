<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gcs_tile_tools</name>
  <version>0.1.0</version>
  <description>C++ (Qt) tools for offline map tiles: draw a test MBTiles pack, and import packs into the GCS maptiles.db.</description>
  <maintainer email="you@example.com">GCS team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- Qt 6 (Core, Gui, Sql + the SQLite driver) is installed with apt; see HOW_TO_RUN.md. -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
